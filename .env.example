GROQ_API_KEY=your-groq-api-key
GROQ_BASE_URL=https://api.groq.com/openai/v1
# Optional; defaults to qwen/qwen3.8-27b
# GROQ_MODEL=qwen/qwen3.8-27b

# Local session identity and storage (set a stable unique owner ID per user)
# MYAGENT_OWNER_ID=local-user
# MYAGENT_DATA_DIR=~/.myagent
# MYAGENT_WORKSPACE=.

# Optional FastAPI compatibility tokens: map bearer tokens to stable owner IDs.
# MYAGENT_API_TOKENS={"replace-with-long-random-token":"alice"}
# MYAGENT_API_HOST=127.0.0.1
# MYAGENT_API_PORT=8000
# MYAGENT_API_WORKSPACE_ROOT=~/.myagent/workspaces
# Set true only when public self-registration is intended.
# MYAGENT_SIGNUP_ENABLED=false
