# Optional CLI-only default provider. Signed-in web users configure their own model endpoint in Settings.
# GROQ_API_KEY=your-groq-api-key
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# Optional; when omitted (or set to auto), selects the first model from /models.
# GROQ_MODEL=llama-3.3-70b-versatile
# Optional model display aliases (model IDs remain unchanged in requests).
# GROQ_MODEL_ALIASES={"llama-3.3-70b-versatile":"Llama 3.3 70B"}

# Optional OpenAI-compatible cloud fallback for primary endpoint failures.
# MYAGENT_FALLBACK_BASE_URL=https://api.groq.com/openai/v1
# MYAGENT_FALLBACK_API_KEY=your-fallback-api-key
# MYAGENT_FALLBACK_MODEL=llama-3.3-70b-versatile

# Required to save API keys in account settings. Generate with:
# uv run python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
MYAGENT_SETTINGS_ENCRYPTION_KEY=
# Required only when users connect to private/local model endpoints. Enables
# authenticated users to make the API server access private network addresses.
# MYAGENT_ALLOW_PRIVATE_MODEL_ENDPOINTS=true

# Local session identity and storage (set a stable unique owner ID per user)
# MYAGENT_OWNER_ID=local-user
# MYAGENT_DATA_DIR=~/.myagent
# MYAGENT_WORKSPACE=.

# Optional FastAPI compatibility tokens: map bearer tokens to stable owner IDs.
# MYAGENT_API_TOKENS={"replace-with-long-random-token":"alice"}
# MYAGENT_API_HOST=127.0.0.1
# MYAGENT_API_PORT=5000
# MYAGENT_API_WORKSPACE_ROOT=~/.myagent/workspaces
# Set true only when public self-registration is intended.
# MYAGENT_SIGNUP_ENABLED=false

# Built-in SearXNG MCP. Start the local service with compose.searxng.yml.
SEARXNG_URL=http://127.0.0.1:8080
SEARXNG_LITE_TOOLS=false
SEARXNG_TIMEOUT_MS=10000
FETCH_TIMEOUT_MS=10000
URL_READ_MAX_CHARS=12000
# Optional if npx is not available on PATH:
# MCP_SEARXNG_COMMAND=npx
# MCP_SEARXNG_ARGS=-y mcp-searxng
